# copy to .env and fill in. keys: https://api.data.gov/signup/
GOVWATCH_CONGRESS_API_KEY=
GOVWATCH_REGULATIONS_API_KEY=
GOVWATCH_DATABASE_URL=postgresql://govwatch:govwatch@localhost:5432/govwatch
GOVWATCH_POLL_INTERVAL_SECONDS=900
GOVWATCH_BACKFILL_DAYS=7
GOVWATCH_METRICS_HOST=127.0.0.1
GOVWATCH_METRICS_PORT=9100
