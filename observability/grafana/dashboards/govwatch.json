    {
      "type": "stat",
      "id": 14,
      "title": "Gaps found (7d)",
      "description": "Audits that found missing records. Each one triggers a re-ingest of the window; gaps that keep coming back point at a bug in the ingest path.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "govwatch-db"
      },
      "gridPos": {
        "x": 9,
        "y": 23,
        "w": 4,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "govwatch-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT s.source, count(a.*) FILTER (WHERE a.missing > 0) AS gaps\nFROM (VALUES ('congress'), ('regulations')) s(source)\nLEFT JOIN v_completeness_audits a\n  ON a.source = s.source AND a.audited_at > now() - interval '7 days'\nGROUP BY s.source ORDER BY s.source"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "decimals": 0,
          "displayName": "${__data.fields.source}"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "type": "table",
      "id": 15,
      "title": "Recent audits",
      "description": "Each audit asks the API how many records changed in the window and compares with Postgres.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "govwatch-db"
      },
      "gridPos": {
        "x": 13,
        "y": 23,
        "w": 11,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "govwatch-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT audited_at AS \"audited\", source,\n       to_char(window_start, 'MM-DD') || ' to ' || to_char(window_end, 'MM-DD') AS \"window\",\n       upstream_count AS \"upstream\", local_count AS \"stored\", missing, completeness\nFROM v_completeness_audits\nORDER BY audited_at DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "audited"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.width",
                "value": 135
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "source"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 95
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "window"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 115
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "upstream"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "stored"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "missing"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "completeness"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "missing"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
