            "uid": "prometheus"
          },
          "expr": "sum by (source) (increase(govwatch_ingest_records_seen_total[1h]))",
          "legendFormat": "{{source}} seen",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source) (increase(govwatch_ingest_records_changed_total[1h]))",
