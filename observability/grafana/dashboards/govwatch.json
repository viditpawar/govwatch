{
  "uid": "govwatch",
  "title": "govwatch",
  "description": "Ingestion health for congress.gov and regulations.gov, plus what's moving in the data.",
  "tags": [
    "govwatch"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "title": "Runbook",
      "type": "link",
      "targetBlank": true,
      "icon": "doc",
      "url": "https://github.com/viditpawar/govwatch/blob/main/docs/runbook.md"
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Pipeline health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Ingestion lag",
      "description": "Time since the last successful run per source. SLO: under 30 minutes, 99% of the time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "govwatch:ingest_lag_seconds",
          "legendFormat": "{{source}}",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1800
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Newest record age",
      "description": "Age of the newest stored record. congress.gov timestamps are whole days, so 1-3 days there is normal.",
