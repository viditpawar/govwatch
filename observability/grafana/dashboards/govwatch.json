      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source) (increase(govwatch_ingest_runs_total{status=\"success\"}[24h])) / sum by (source) (increase(govwatch_ingest_runs_total[24h]))",
