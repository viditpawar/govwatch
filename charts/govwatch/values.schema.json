{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "config", "apiKeys", "database"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "pollIntervalSeconds": { "type": "integer", "minimum": 60 },
        "backfillDays": { "type": "integer", "minimum": 1, "maximum": 365 },
        "auditIntervalSeconds": { "type": "integer", "minimum": 600 },
        "auditWindowDays": { "type": "integer", "minimum": 1, "maximum": 30 },
        "auditAutoRepair": { "type": "boolean" },
        "logLevel": { "enum": ["DEBUG", "INFO", "WARNING", "ERROR"] }
      }
    },
    "apiKeys": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "congress": { "type": "string" },
        "regulations": { "type": "string" }
      }
    },
    "agent": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ollamaUrl": { "type": "string", "pattern": "^https?://" },
        "ollamaPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "model": { "type": "string", "minLength": 1 },
        "batchSize": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "service": {
          "type": "object",
          "properties": {
            "type": { "enum": ["ClusterIP", "NodePort"] },
            "nodePort": { "type": ["integer", "null"], "minimum": 30000, "maximum": 32767 }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "uriKey": { "type": "string", "minLength": 1 },
        "cnpg": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "instances": { "type": "integer", "minimum": 1 },
            "storageSize": { "type": "string" }
          }
        }
      }
    }
  }
}
